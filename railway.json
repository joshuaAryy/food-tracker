{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "corepack pnpm prisma:generate && corepack pnpm build",
    "watchPatterns": [
      "apps/api/**",
      "packages/shared/**",
      "pnpm-lock.yaml",
      "railway.json"
    ]
  },
  "deploy": {
    "preDeployCommand": "corepack pnpm --filter @food-tracker/api migrate:deploy:ready",
    "startCommand": "corepack pnpm --filter @food-tracker/api start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
