{
  "name": "food-tracker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev:api": "corepack pnpm --filter @food-tracker/api dev",
    "dev:mobile": "corepack pnpm --filter @food-tracker/mobile start",
    "build": "corepack pnpm --filter @food-tracker/shared build && corepack pnpm --filter @food-tracker/api build",
    "typecheck": "corepack pnpm -r typecheck",
    "lint": "corepack pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "corepack pnpm --filter @food-tracker/api test",
    "test:watch": "corepack pnpm --filter @food-tracker/api test:watch",
    "test:coverage": "corepack pnpm --filter @food-tracker/api test:coverage",
    "prisma:generate": "corepack pnpm --filter @food-tracker/api prisma:generate",
    "prisma:validate": "corepack pnpm --filter @food-tracker/api prisma:validate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.53.1"
  }
}
