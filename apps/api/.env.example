PORT=3000
# Local development placeholder. A real running PostgreSQL database is required before migrations or persistence.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/food_tracker"

# AI text logging is backend-only. Do not expose Gemini keys to mobile clients.
AI_PROVIDER=disabled
GEMINI_API_KEY=
GEMINI_FOOD_PARSE_MODEL=gemini-2.5-flash
AI_FOOD_PARSE_MAX_DESCRIPTION_CHARS=500
AI_FOOD_PARSE_MAX_ITEMS=8
AI_FOOD_PARSE_TIMEOUT_MS=8000
AI_FOOD_PARSE_RATE_LIMIT_WINDOW=600000
AI_FOOD_PARSE_RATE_LIMIT_MAX=5
AI_FOOD_PARSE_DAILY_LIMIT=25

# Generic food nutrition lookup is backend-only. Do not expose USDA keys to mobile clients.
USDA_FDC_API_KEY=
USDA_FDC_BASE_URL=https://api.nal.usda.gov/fdc/v1
USDA_FDC_TIMEOUT_MS=5000
USDA_FDC_SEARCH_LIMIT=3
USDA_FDC_RATE_LIMIT_WINDOW=600000
USDA_FDC_RATE_LIMIT_MAX=20
