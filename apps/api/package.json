{
  "name": "@food-tracker/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test vitest.config.ts",
    "benchmark:food-retrieval": "tsx src/benchmarks/food-retrieval/cli.ts",
    "test": "corepack pnpm --filter @food-tracker/shared build && vitest run",
    "test:food-retrieval-benchmark": "vitest run --config test/food-retrieval-benchmark.vitest.config.ts",
    "test:watch": "corepack pnpm --filter @food-tracker/shared build && vitest",
    "test:coverage": "corepack pnpm --filter @food-tracker/shared build && vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "seed:staging-analytics-qa": "tsx src/scripts/seed-staging-analytics-qa.ts",
    "food:import": "tsx src/scripts/import-food-dataset.ts",
    "benchmark:food-retrieval-live": "tsx src/benchmarks/food-retrieval/live-cli.ts",
    "benchmark:food-seed": "tsx src/scripts/seed-food-retrieval-benchmark.ts",
    "food:reindex": "tsx src/scripts/reindex-food-search.ts"
  },
  "dependencies": {
    "@food-tracker/shared": "workspace:*",
    "@pinecone-database/pinecone": "^8.2.0",
    "@prisma/client": "6.19.2",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.0",
    "firebase-admin": "14.2.0",
    "helmet": "^8.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.8",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "4.1.6",
    "prisma": "6.19.2",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "4.1.6"
  }
}
