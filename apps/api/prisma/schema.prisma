generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GoalType {
  lose
  maintain
  gain
}

enum ActivityLevel {
  sedentary
  lightly_active
  moderately_active
  very_active
  athlete
}

enum TrainingStyle {
  none
  cardio
  weight_training
  mixed
  athlete
}

enum GoalPace {
  slow
  moderate
  aggressive
  lean_bulk
  moderate_bulk
  aggressive_bulk
}

enum TrackingMode {
  simple
  complex
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
  other
}

enum RecommendationSeverity {
  low
  medium
  high
}

enum RecommendationStatus {
  active
  dismissed
  archived
}

enum FoodItemSourceType {
  user_custom
  cached_external
  app_owned
}

enum FoodItemType {
  generic
  branded
}

enum FoodSourceProvider {
  open_food_facts
  usda_fdc
  manual
  other
}

enum NutrientKey {
  calories
  protein
  carbs
  fat
  fiber
  sugar
  sodium
  addedSugar
  starch
  solubleFiber
  insolubleFiber
  sugarAlcohol
  saturatedFat
  transFat
  monounsaturatedFat
  polyunsaturatedFat
  omega3
  omega6
  cholesterol
  histidine
  isoleucine
  leucine
  lysine
  methionine
  phenylalanine
  threonine
  tryptophan
  valine
  alanine
  arginine
  asparticAcid
  cystine
  glutamicAcid
  glycine
  proline
  serine
  tyrosine
  potassium
  caffeine
  alcohol
  water
  oxalate
  phytate
  vitaminA
  thiamine
  riboflavin
  niacin
  pantothenicAcid
  vitaminB6
  biotin
  folate
  vitaminB12
  vitaminC
  vitaminD
  vitaminE
  vitaminK
  calcium
  iron
  magnesium
  zinc
  phosphorus
  selenium
  copper
  manganese
  iodine
  chromium
  molybdenum
  chloride
}

enum NutrientUnit {
  kcal
  g
  mg
  mcg
}

model User {
  id                         String                      @id @default(uuid()) @db.Uuid
  email                      String?
  createdAt                  DateTime                    @default(now()) @db.Timestamptz
  updatedAt                  DateTime                    @updatedAt @db.Timestamptz
  profile                    UserProfile?
  goal                       UserGoal?
  trackingPreference         TrackingPreference?
  foodLogs                   FoodLog[]
  recipes                    Recipe[]
  foodItems                  FoodItem[]
  savedFoodItems             SavedFoodItem[]
  foodItemServingPreferences FoodItemServingPreference[]
  weightLogs                 WeightLog[]
  recommendations            Recommendation[]
}

model UserProfile {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @unique @db.Uuid
  name             String?
  age              Int?
  birthDate        DateTime?      @db.Date
  sex              String?
  heightInches     Int?
  timezone         String         @default("America/Toronto")
  startingWeightLb Decimal?       @db.Decimal(5, 1)
  activityLevel    ActivityLevel?
  trainingStyle    TrainingStyle?
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserGoal {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @unique @db.Uuid
  goalType           GoalType
  goalPace           GoalPace?
  targetWeightLb     Decimal?  @db.Decimal(5, 1)
  targetCalories     Int?
  targetProteinGrams Decimal?  @db.Decimal(5, 1)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TrackingPreference {
  id                   String       @id @default(uuid()) @db.Uuid
  userId               String       @unique @db.Uuid
  mode                 TrackingMode
  waterTrackingEnabled Boolean      @default(false)
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FoodLog {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @db.Uuid
  foodItemId        String?           @db.Uuid
  recipeId          String?           @db.Uuid
  foodName          String
  mealType          MealType
  calories          Int
  protein           Decimal           @db.Decimal(6, 1)
  carbs             Decimal?          @db.Decimal(6, 1)
  fat               Decimal?          @db.Decimal(6, 1)
  fiber             Decimal?          @db.Decimal(6, 1)
  sugar             Decimal?          @db.Decimal(6, 1)
  sodium            Int?
  servingQuantity   Decimal?          @db.Decimal(8, 2)
  servingUnit       String?
  servingSnapshot   Json?
  recipeSnapshot    Json?
  mixedMealSnapshot Json?
  notes             String?
  loggedAt          DateTime          @db.Timestamptz
  createdAt         DateTime          @default(now()) @db.Timestamptz
  updatedAt         DateTime          @updatedAt @db.Timestamptz
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodItem          FoodItem?         @relation(fields: [foodItemId], references: [id], onDelete: SetNull)
  derivedFoodItem   FoodItem?         @relation("DerivedFromFoodLog")
  recipe            Recipe?           @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  nutrients         FoodLogNutrient[]

  @@index([userId])
  @@index([foodItemId])
  @@index([recipeId])
  @@index([loggedAt])
  @@index([userId, loggedAt])
  @@index([userId, mealType])
}

model FoodItem {
  id                   String                      @id @default(uuid()) @db.Uuid
  userId               String?                     @db.Uuid
  name                 String
  brandName            String?
  description          String?
  sourceType           FoodItemSourceType
  foodType             FoodItemType
  normalizedName       String
  normalizedBrandName  String?
  searchText           String
  servingQuantity      Decimal?                    @db.Decimal(8, 2)
  servingUnit          String?
  servingWeightGrams   Decimal?                    @db.Decimal(8, 2)
  servingOptions       Json?
  calories             Int?
  protein              Decimal?                    @db.Decimal(6, 1)
  carbs                Decimal?                    @db.Decimal(6, 1)
  fat                  Decimal?                    @db.Decimal(6, 1)
  fiber                Decimal?                    @db.Decimal(6, 1)
  sugar                Decimal?                    @db.Decimal(6, 1)
  sodium               Int?
  additionalNutrients  Json?
  sourceProvider       FoodSourceProvider?
  sourceId             String?
  sourceUpdatedAt      DateTime?                   @db.Timestamptz
  archivedAt           DateTime?                   @db.Timestamptz
  derivedFromFoodLogId String?                     @unique @db.Uuid
  createdAt            DateTime                    @default(now()) @db.Timestamptz
  updatedAt            DateTime                    @updatedAt @db.Timestamptz
  user                 User?                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  barcodes             FoodBarcode[]
  savedByUsers         SavedFoodItem[]
  foodLogs             FoodLog[]
  derivedFromFoodLog   FoodLog?                    @relation("DerivedFromFoodLog", fields: [derivedFromFoodLogId], references: [id], onDelete: SetNull)
  servingPreferences   FoodItemServingPreference[]
  recipeIngredients    RecipeIngredient[]
  nutrients            FoodItemNutrient[]

  @@index([userId])
  @@index([sourceType])
  @@index([foodType])
  @@index([archivedAt])
  @@index([normalizedName])
  @@index([normalizedBrandName])
}

model FoodItemServingPreference {
  id                     String   @id @default(uuid()) @db.Uuid
  userId                 String   @db.Uuid
  foodItemId             String   @db.Uuid
  defaultServingQuantity Decimal  @db.Decimal(8, 2)
  defaultServingUnit     String
  defaultServingOptionId String?
  createdAt              DateTime @default(now()) @db.Timestamptz
  updatedAt              DateTime @updatedAt @db.Timestamptz
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodItem               FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)

  @@unique([userId, foodItemId])
  @@index([userId])
  @@index([foodItemId])
}

model Recipe {
  id                     String             @id @default(uuid()) @db.Uuid
  userId                 String             @db.Uuid
  name                   String
  description            String?
  portionCount           Int
  finalCookedWeightGrams Decimal?           @db.Decimal(8, 2)
  archivedAt             DateTime?          @db.Timestamptz
  createdAt              DateTime           @default(now()) @db.Timestamptz
  updatedAt              DateTime           @updatedAt @db.Timestamptz
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredients            RecipeIngredient[]
  foodLogs               FoodLog[]

  @@index([userId])
  @@index([archivedAt])
  @@index([userId, archivedAt])
}

model RecipeIngredient {
  id                 String    @id @default(uuid()) @db.Uuid
  recipeId           String    @db.Uuid
  foodItemId         String?   @db.Uuid
  position           Int
  ingredientSnapshot Json
  createdAt          DateTime  @default(now()) @db.Timestamptz
  updatedAt          DateTime  @updatedAt @db.Timestamptz
  recipe             Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  foodItem           FoodItem? @relation(fields: [foodItemId], references: [id], onDelete: SetNull)

  @@unique([recipeId, position])
  @@index([recipeId])
  @@index([foodItemId])
}

model FoodItemNutrient {
  id          String       @id @default(uuid()) @db.Uuid
  foodItemId  String       @db.Uuid
  nutrientKey NutrientKey
  amount      Decimal      @db.Decimal(12, 4)
  unit        NutrientUnit
  createdAt   DateTime     @default(now()) @db.Timestamptz
  updatedAt   DateTime     @updatedAt @db.Timestamptz
  foodItem    FoodItem     @relation(fields: [foodItemId], references: [id], onDelete: Cascade)

  @@unique([foodItemId, nutrientKey])
  @@index([foodItemId])
  @@index([nutrientKey])
}

model FoodLogNutrient {
  id          String       @id @default(uuid()) @db.Uuid
  foodLogId   String       @db.Uuid
  nutrientKey NutrientKey
  amount      Decimal      @db.Decimal(12, 4)
  unit        NutrientUnit
  createdAt   DateTime     @default(now()) @db.Timestamptz
  updatedAt   DateTime     @updatedAt @db.Timestamptz
  foodLog     FoodLog      @relation(fields: [foodLogId], references: [id], onDelete: Cascade)

  @@unique([foodLogId, nutrientKey])
  @@index([foodLogId])
  @@index([nutrientKey])
}

model FoodBarcode {
  id            String   @id @default(uuid()) @db.Uuid
  foodItemId    String   @db.Uuid
  barcode       String
  barcodeFormat String?
  regionCode    String   @default("GLOBAL")
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz
  foodItem      FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)

  @@unique([barcode, regionCode])
  @@index([barcode])
  @@index([foodItemId])
}

model SavedFoodItem {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  foodItemId String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodItem   FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)

  @@unique([userId, foodItemId])
  @@index([userId])
  @@index([foodItemId])
}

model WeightLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  weightLb  Decimal  @db.Decimal(5, 1)
  loggedAt  DateTime @db.Timestamptz
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([loggedAt])
  @@index([userId, loggedAt])
}

model Recommendation {
  id          String                 @id @default(uuid()) @db.Uuid
  userId      String                 @db.Uuid
  type        String
  severity    RecommendationSeverity
  title       String
  message     String
  sourceFacts Json
  status      RecommendationStatus
  createdAt   DateTime               @default(now()) @db.Timestamptz
  updatedAt   DateTime               @updatedAt @db.Timestamptz
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([userId, createdAt])
}
