APP_ENV=development
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APPLE_SIGN_IN_ENABLED=false
# Development may use localhost or a LAN address for local device testing.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Provider configuration is injected per environment. Do not commit plist files
# or real credentials.
GOOGLE_SERVICES_PLIST_PATH=
GOOGLE_IOS_URL_SCHEME=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Phase 17 uses a separate ignored apps/mobile/.env.staging-release.local file.
# It must contain APP_ENV=staging, RAILWAY_STAGING_API_HOST, and
# EXPO_PUBLIC_APP_ENV=staging, with the matching HTTPS API base ending in
# /api/v1, the public Google web client ID,
# GOOGLE_IOS_URL_SCHEME, GOOGLE_SERVICES_PLIST_PATH, and EXPO_NO_DOTENV=1.
# Never put Firebase Admin, database, provider, rate-limit, or proof secrets in
# this file or any EXPO_PUBLIC_* variable.
